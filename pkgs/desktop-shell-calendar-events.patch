+
+  // ---- Upcoming events (read-only): khal reads the local copy that vdirsyncer
+  //      keeps in sync. One line per event: date|start|end|title (empty times
+  //      for all-day events). Rows are flattened to day headings and events.
+  property var eventRows: []
+  readonly property int eventDays: 7
+  readonly property int eventLimit: 8
+
+  function loadEvents() {
+    if (eventsProc.running) return
+    eventsProc.running = true
+  }
+
+  function parseEvents(raw) {
+    var rows = []
+    var count = 0
+    var lastDate = ""
+    var lines = String(raw || "").split("\n")
+    for (var i = 0; i < lines.length && count < root.eventLimit; ++i) {
+      var parts = lines[i].split("|")
+      if (parts.length < 4 || !/^\d{4}-\d{2}-\d{2}$/.test(parts[0])) continue
+      // --once lists a multi-day event one time; one that started before today sits under today.
+      var day = parts[0] < root.todayKey ? root.todayKey : parts[0]
+      if (day !== lastDate) {
+        lastDate = day
+        var d = new Date(Number(day.slice(0, 4)), Number(day.slice(5, 7)) - 1, Number(day.slice(8, 10)), 12)
+        rows.push({ heading: true, text: d.toLocaleDateString(root.labelLocale, "ddd d MMM") })
+      }
+      var time = parts[1] ? (parts[2] ? parts[1] + " - " + parts[2] : parts[1]) : ""
+      rows.push({ heading: false, time: time, text: parts.slice(3).join("|") })
+      count++
+    }
+    return rows
+  }
+
+  Process {
+    id: eventsProc
+    command: ["khal", "list", "--once", "--day-format", "", "--format",
+      "{start-date}|{start-time}|{end-time}|{title}", "today", root.eventDays + "d"]
+    stdout: StdioCollector {
+      waitForEnd: true
+      onStreamFinished: root.eventRows = root.parseEvents(text)
+    }
+    // No calendars set up (or khal fails): show the empty state.
+    onExited: function(exitCode) { if (exitCode !== 0) root.eventRows = [] }
   }
 
