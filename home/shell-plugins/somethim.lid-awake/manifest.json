{
  "schemaVersion": 1,
  "id": "somethim.lid-awake",
  "name": "Lid Awake Indicators",
  "version": "2.1.0",
  "author": "somethim",
  "description": "Status indicators plus Lid Awake: a drop-in replacement for omarchy.indicators",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Indicators.qml"
  },
  "barWidget": {
    "displayName": "Lid Awake Indicators",
    "description": "Status indicators plus Lid Awake",
    "category": "Status",
    "allowMultiple": true,
    "schema": [
      {
        "key": "items",
        "type": "multiselect",
        "label": "Indicators",
        "description": "Choose which indicators this widget instance should show. Leave empty to show all indicators.",
        "noSelectionText": "All indicators",
        "placeholderText": "Search indicators...",
        "emptyText": "No indicators",
        "options": [
          {
            "value": "ScreenRecording",
            "label": "Screen recording",
            "description": "GPU screen recorder status"
          },
          {
            "value": "Reminder",
            "label": "Reminder",
            "description": "Queued reminder status"
          },
          {
            "value": "Dnd",
            "label": "Do not disturb",
            "description": "Notification silencing"
          },
          {
            "value": "StayAwake",
            "label": "Stay awake",
            "description": "Idle lock and screensaver override"
          },
          {
            "value": "LidAwake",
            "label": "Lid awake",
            "description": "Keep running with the lid closed (laptops only)"
          }
        ]
      },
      {
        "key": "alwaysShow",
        "type": "boolean",
        "label": "Always Show",
        "description": "Show inactive indicators without waiting for hover.",
        "defaultValue": false
      }
    ]
  },
  "omarchy": {
    "clonedFrom": "omarchy.indicators"
  },
  "license": "MIT"
}
